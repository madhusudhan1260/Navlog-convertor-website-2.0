{
  "manifest_version": 3,
  "name": "EFLIGHT AI - ForeFlight Bridge",
  "version": "1.0",
  "description": "Lets the EFLIGHT AI Navlog Converter fetch a pasted ForeFlight link using your already-logged-in ForeFlight session, so you don't have to save and upload the file yourself.",
  "key": "",
  "host_permissions": [
    "https://plan.foreflight.com/*",
    "https://cloudfront.foreflight.com/*",
    "https://*.cloudfront.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "http://localhost/*",
      "http://127.0.0.1:5173/*"
    ]
  }
}
